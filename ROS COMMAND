ROS COMMAND

Vòng đời làm việc: thuộc lòng
→Viết code 
→ sửa setup.py (entry_points) 
→ colcon build ở root workspace 
→source install/setup.bash 
→ ros2 run 


#Tạo Workspace
mkdir -p ~/ros2_ws/src


#Tạo Package Python
cd ~/ros2_ws/src
ros2 pkg create --build-type ament_python my_package


#Them option
ros2 pkg create --build-type ament_python my_package \
  --dependencies rclpy std_msgs
  

#Tạo Package C++
ros2 pkg create --build-type ament_cmake my_package


#Build & install Pakage
colcon build --packages-select <Package name>
source install/setup.bash

#Bàn phím Teleop
ros2 run teleop_twist_keyboard teleop_twist_keyboard

# Xem list Topic
ros2 topic list

# Test LiDAR có data không
ros2 topic echo /scan --once

# Test odometry
ros2 topic echo /odom --once
