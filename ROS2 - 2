
#Bàn phím Teleop
ros2 run teleop_twist_keyboard teleop_twist_keyboard


ros2 topic list
ros2 topic echo /scan --once
ros2 topic echo /odom --once


cd ~/ros2_ws
colcon build --packages-select agv_description
source install/setup.bash

ros2 launch agv_description gazebo.launch.py #Chạy Gazebo

#Chạy nav với map đã lưu
ros2 launch nav2_bringup bringup_launch.py \
  map:=$HOME/ros2_ws/src/agv_description/maps/warehouse_map.yaml \
  params_file:=$HOME/ros2_ws/src/agv_description/config/nav2_params.yaml \
  use_sim_time:=true


# Chạy Rviz2 với Nav2 config sẵn có
ros2 launch nav2_bringup rviz_launch.py


ros2 action send_goal /navigate_to_pose nav2_msgs/action/NavigateToPose \
"{pose: {header: {frame_id: 'map'}, pose: {position: {x: -2.5, y: 0.3, z: 0.0}, orientation: {x: 0.0, y: 0.0, z: 0.7071068, w: 0.7071068}}}}" \
--feedback

#gui lenh chạy task - move

ros2 launch agv_task_dispatcher dispatcher.launch.py
ros2 topic pub --once /task_queue/add std_msgs/String \
 "data: '{\"id\":\"shelf_C\",\"x\":2.0,\"y\":1.0,\"yaw\":0.0,\"priority\":0}'"


# AI 
colcon build --packages-select agv_perception
source install/setup.bash
ros2 run agv_perception ai_detector_node

